# AI Service Configuration
# Copy this to .env and configure as needed

# Application
VERSION=0.1.0
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8001
LOG_LEVEL=INFO

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Provider Configuration
# Options: ollama, openai, anthropic
AI_PROVIDER=ollama
AI_TIMEOUT=300
AI_MAX_RETRIES=3

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:7b
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=800
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_NUM_CTX=2048

# OpenAI Configuration (requires API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=800
OPENAI_TOP_P=0.9

# Anthropic Configuration (requires API key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-sonnet-20240229
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TOP_P=0.9

# Chunked Summary Pipeline Configuration
# These settings control how the chunked summary pipeline processes large campaigns

# Context limits (tokens) - affects how much data is sent per API call
OLLAMA_CONTEXT_LIMIT=6000
OPENAI_CONTEXT_LIMIT=100000
ANTHROPIC_CONTEXT_LIMIT=150000

# Batch sizes (items per extraction call) - affects API call frequency
OLLAMA_BATCH_SIZE=8
OPENAI_BATCH_SIZE=40
ANTHROPIC_BATCH_SIZE=40

# Token estimation
CHARS_PER_TOKEN=4
