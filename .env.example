# Tavkit Environment Configuration
# Copy this file to .env and update with your values

# ============================================
# Backend Configuration (Go)
# ============================================

# Server
PORT=8000
ENVIRONMENT=development  # development, production
HOST=0.0.0.0

# =============================================================================
# PYTHON AI SERVICE (Campaign Summary Generation)
# =============================================================================
# The Python AI Service is used for campaign summary generation in the
# Campaign Ledger feature. It processes large amounts of campaign content
# (NPCs, locations, quests, session notes, etc.) and generates intelligent
# summaries using the configured AI provider.
#
# Content generation (NPCs, monsters, encounters, etc.) is handled directly
# by the Go backend for all providers (Ollama, Anthropic, OpenAI).
PYTHON_AI_SERVICE_URL=http://ai-service:8001


# ==================================================
# Database Configuration - Choose ONE option:
# ==================================================
#
# OPTION 1: SQLite (Recommended for local testing)
#   - Fast setup, no separate database server needed
#   - Perfect for development and testing
#   - Use with: make up-ollama
DB_TYPE=sqlite
DB_PATH=./data/tavkit.db

# OPTION 2: PostgreSQL (Docker container)
#   - Better for production-like testing
#   - Requires docker compose --profile postgres
#   - Use with: make up-full (Ollama + PostgreSQL)
# DB_TYPE=postgres
# DB_HOST=postgres
# DB_PORT=5432
# DB_NAME=tavkit
# DB_USER=tavkit
# DB_PASSWORD=changeme_secure_password_min_32_chars
# DB_SSLMODE=disable  # disable for development, require for production
# DB_MAX_CONNECTIONS=25
# DB_MAX_IDLE_CONNECTIONS=5

# OPTION 3: External PostgreSQL (Your own database)
#   - Connect to existing PostgreSQL instance
#   - Use with: make up-ollama (backend connects externally)
# DB_TYPE=postgres
# DB_HOST=localhost  # or your database server
# DB_PORT=5432
# DB_NAME=tavkit
# DB_USER=tavkit
# DB_PASSWORD=your_secure_password
# DB_SSLMODE=require

# Authentication
JWT_SECRET=changeme_min_32_characters_random_string
JWT_EXPIRATION=24h  # 24 hours
JWT_REFRESH_EXPIRATION=168h  # 7 days

# Default Admin User (created automatically on first startup if no users exist)
# ⚠️ IMPORTANT: Change these before deploying to production!
ADMIN_EMAIL=admin@tavkit.local
ADMIN_PASSWORD=changeme123
ADMIN_USERNAME=admin

# Security & CORS Configuration
# IMPORTANT: Add your frontend URL(s) to CORS_ALLOWED_ORIGINS
# For local development: http://localhost:3000,http://localhost:5173
# For network deployment: http://192.168.x.x:8080,http://your-domain.com
# For wildcard (INSECURE - dev only): *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://tavkit.local,http://tavkit.local
CORS_ALLOW_CREDENTIALS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Logging
LOG_LEVEL=info  # debug, info, warn, error
LOG_FORMAT=json  # json, text

# ==================================================
# AI Provider Flexibility Configuration
# ==================================================
# TavKit now supports multiple AI providers with runtime switching!
# You can deploy with or without AI, and switch providers without redeployment.

# Master AI Switch
# Set to false to deploy without AI features (smallest footprint)
ENABLE_AI=true

# Primary LLM Provider (ollama, anthropic, openai)
# You can switch this at runtime through the Settings UI
AI_PROVIDER=ollama  # Options: ollama (local), anthropic (Claude), openai (GPT)

# ==================================================
# Ollama Configuration - Two Deployment Options:
# ==================================================
# 
# OPTION 1: Use host Ollama (Recommended - Windows/Mac/Linux)
#   Run Ollama on your host machine, containers access via special hostname
#   Uses: OLLAMA_BASE_URL=http://host.docker.internal:11434
#   Works on: Windows, Mac, Linux with Docker Desktop
#
# OPTION 2: Deploy Ollama in Docker (Optional - Linux only)
#   docker compose --profile ollama up
#   Uses internal Docker network: OLLAMA_BASE_URL=http://ollama:11434
#   Note: Only needed if not running Ollama on host
#
# OPTION 3: External Ollama server (Remote machine)
#   OLLAMA_BASE_URL=http://your-server-ip:11434
#
# Model Selection (smaller = faster, larger = better quality):
#   llama3.2:1b  - Fastest (1.3GB) - Quick testing
#   llama3.2:3b  - Balanced (2GB) - Recommended default
#   llama3.1:8b  - Powerful (4.7GB) - Best quality output
#   mistral:7b   - Alternative (4.1GB) - Good for creative text
## Ollama (local) settings are disabled by default when using Anthropic.
## Uncomment and change AI_PROVIDER back to `ollama` to enable local Ollama.
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # host.docker.internal for host Ollama (recommended)
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_PORT=11434
# OLLAMA_TIMEOUT=120  # seconds
# OLLAMA_NUM_CTX=4096  # context window size

# OpenAI Configuration (optional cloud fallback)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2048

# Anthropic (Claude) Configuration
# Add your Claude API key here (DO NOT commit this file with a real key).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2048

# AI Generation Settings
AI_TEMPERATURE=0.7  # 0.0-1.0 (lower = more deterministic)
AI_TOP_P=0.9
AI_MAX_RETRIES=3

# ============================================
# Frontend Configuration (React)
# ============================================
# NOTE: Frontend uses web/.env.production for Docker builds
# This .env file is only for backend configuration

# API Endpoints (for local development)
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000

# Feature Flags
VITE_ENABLE_AI=true
VITE_ENABLE_GIT_INTEGRATION=true
VITE_ENABLE_DICE_ROLLER=true

# ============================================
# External Integrations
# ============================================

# GitLab
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=  # Personal access token (optional)

# GitHub
GITHUB_URL=https://github.com
GITHUB_TOKEN=  # Personal access token (optional)

# Gitea/Forgejo
GITEA_URL=  # Your Gitea/Forgejo instance URL
GITEA_TOKEN=  # Access token (optional)

# ============================================
# Docker Configuration
# ============================================

# Compose Project Name
COMPOSE_PROJECT_NAME=tavkit

# Build Architecture (set based on your machine)
# - arm64 for Apple Silicon (M1/M2/M3/M4)
# - amd64 for Intel/AMD processors
BUILD_ARCH=arm64

# Container Names (customize if running multiple instances)
POSTGRES_CONTAINER_NAME=tavkit-postgres
BACKEND_CONTAINER_NAME=tavkit-backend
AI_SERVICE_CONTAINER_NAME=tavkit-ai-service
OLLAMA_CONTAINER_NAME=tavkit-ollama
OLLAMA_INIT_CONTAINER_NAME=tavkit-ollama-init
WEB_CONTAINER_NAME=tavkit-web
CADDY_CONTAINER_NAME=tavkit-caddy

# Docker Images (override to use specific versions or custom images)
POSTGRES_IMAGE=postgres:17-alpine
OLLAMA_IMAGE=ollama/ollama:latest
CADDY_IMAGE=caddy:2-alpine

# Service Ports (host:container mapping)
BACKEND_PORT=8000
BACKEND_INTERNAL_PORT=8000
AI_SERVICE_PORT=8001
AI_SERVICE_INTERNAL_PORT=8001
WEB_PORT=3000
WEB_INTERNAL_PORT=80
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_HTTP3_PORT=443

# Restart Policy (no, always, on-failure, unless-stopped)
RESTART_POLICY=unless-stopped

# PostgreSQL (Docker)
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DATA_PATH=./data/postgres

# Ollama (Docker)
OLLAMA_IMAGE=ollama/ollama:latest
OLLAMA_DATA_PATH=./data/ollama

# ============================================
# Deployment Configuration
# ============================================

# Domain (for production)
DOMAIN=tavkit.yourdomain.com

# SSL/TLS
SSL_EMAIL=your.email@example.com
SSL_ENABLED=false  # true for production with Caddy

# Monitoring (optional)
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# ============================================
# Mac Mini M4 Optimization
# ============================================

# Ollama M4 Settings (uncomment for Mac Mini)
# OLLAMA_NUM_PARALLEL=4
# OLLAMA_NUM_GPU=1
# OLLAMA_METAL=1

# ============================================
# Development Only
# ============================================

# Hot Reload
HOT_RELOAD_ENABLED=true

# Debug
DEBUG_SQL=false
DEBUG_AI_PROMPTS=false

# Test Database
TEST_DB_NAME=tavkit_test
TEST_DB_USER=tavkit_test
TEST_DB_PASSWORD=test_password
